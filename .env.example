# --- organizzazione servita da questa istanza ---
# Un'istanza = un comune (self-hosted). COMUNE_ISTAT è la chiave usata
# ovunque nelle query; NOME_COMUNE è il testo mostrato in pagina
# ("Allerta calore per Parma"). ORG_NOME è il nome dell'organizzazione
# ospitante (es. "Distretto di Parma"), distinto da NOME_COMUNE.
COMUNE_ISTAT=034027
NOME_COMUNE=Parma
ORG_NOME="Distretto di Parma"
ORG_TIPO=comune
# bollettino per le 27 citta, stima per tutte le altre. Parma: stima.
RAMO_ALLERTA=stima
CITTA_BOLLETTINO=
ORG_LAT=44.8015
ORG_LON=10.3280

# --- database ---
DATABASE_URL=postgresql://checaldo:checaldo@localhost:5432/checaldo

# --- modalita ---
# La banda "dati sintetici — nessuna persona reale" compare SEMPRE
# tranne che con DEMO_MODE=false esplicito (fail-safe: dimenticare la
# variabile su un VPS pubblico mostra 500 assistiti sintetici con nome
# e indirizzo senza disclaimer, leggibili come reali). Metterla a
# false SOLO su un'installazione operativa con anagrafe vera.
DEMO_MODE=true
# seed fisso: la demo e' identica a ogni esecuzione
FAKER_SEED=42
# data base per il generatore sintetico: valido_fino dei segnali temporanei si
# calcola da qui.
# Vuota (default) = data corrente della macchina al momento di `pnpm seed`.
# Il seed va rigenerato a ridosso di ogni demo (vedi MOD07): non c'e' catena
# che propaga la data al motore, e i segnali temporanei generati settimane
# prima risulterebbero scaduti al giorno del video.
# Valorizzarla (ISO YYYY-MM-DD) solo per riprodurre un seed identico gia' esistente.
DATA_BASE=

# --- modello ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
# Tetto SPECIFICO dell'agente citta (allerta-citta.ts). A regime 1 miss/giorno
# per citta (i livelli cambiano una volta al giorno con il poller). Default 10
# copre "prompt cambiato 5 volte oggi + 5 citta". Al superamento: fallback
# silenzioso (l'agente ritorna null).
LLM_DAILY_MISS_CAP_CITTA=10
# Tetto di spesa: sulla console Anthropic, NON in codice. Il wrapper
# packages/agents/src/client.ts conta le chiamate in pubblico.uso_modello
# per osservabilita' ma non blocca. Un cap hardcoded fallirebbe in silenzio
# nel momento peggiore (nessun testo generato proprio nell'ondata di caldo).
#
# Tetto SPECIFICO del consulente cittadino (MOD06): al superamento delle
# N miss cache-fredde in un giorno, generaConsiglio ritorna null e il
# blocco sparisce dalla pagina — la pagina resta completa con le
# raccomandazioni sanitarie sopra e la mappa. A regime (cache calda)
# genera 0 miss/giorno. Il default 200 copre "prompt cambiato + una
# passata umana sui 13 quartieri × 4 livelli × 2 fasce = 104 combinazioni"
# con margine.
LLM_DAILY_MISS_CAP_CONSULENTE=200

# Tetto SPECIFICO del terzo agente (riassunto della giornata sulla
# dashboard coordinatore). Chiave a scaglioni di 5 contatti: con una giornata
# tipica ~40 contatti = 8 miss/org/giorno. Il default 20 copre 2 org
# nella stessa istanza con margine per premute ripetute oltre la
# variazione naturale della giornata. Al superamento il pulsante mostra
# "tetto giornaliero raggiunto" invece di sparire in silenzio.
LLM_DAILY_MISS_CAP_RIASSUNTO=20

# --- URL di base dell'app ---
# Usata dalle route di login (entra, entra-coordinatore, logout) per costruire
# i redirect assoluti. In sviluppo (NODE_ENV=development) e' opzionale: se
# manca, il codice cade su http://localhost:3000. In produzione l'avvio del
# server web fallisce esplicitamente se APP_URL non e' impostata, per non
# mandare gli utenti sul localhost del VPS in silenzio dopo il login.
APP_URL=http://localhost:3000

# --- sintesi vocale (opzionale) ---
# URL del servizio Piper interno (docker compose service `tts`). Se manca o
# risponde 5xx, le route /api/tts/* tornano 503 e il pulsante di ascolto cade
# sulla sintesi Web Speech del browser dove disponibile (Chrome, Safari,
# Edge): la voce non sparisce, cambia timbro. Su Firefox con impostazioni
# default Web Speech non e' attivo: il pulsante non produce audio ma non
# mostra errore.
TTS_URL=http://tts:8080

# --- override per test / demo ---
# Data forzata "oggi" (ISO YYYY-MM-DD). Se manca, si usa la data corrente in
# fuso Europe/Rome. Serve a fissare la data quando si registra un video demo o
# si riproduce un bug legato al giorno. Vuota in produzione.
CHECALDO_OGGI=

# --- opzionale ---
# Geocoder: se manca, il codice cade sul pubblico https://nominatim.openstreetmap.org
# (rate limit 1 req/s). In produzione, puntare a un'istanza interna dedicata.
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Endpoint Overpass per lo script one-shot estrai-vie.ts. Se manca, default:
# https://overpass-api.de/api/interpreter. Non serve a runtime del web.
OVERPASS_URL=https://overpass-api.de/api/interpreter
OIDC_ISSUER=
