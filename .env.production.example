# .env.production.example — copia in `.env` sul VPS e valorizza a mano.
# NESSUN SEGRETO in questo file: sono tutti placeholder documentati.
#
# `docker compose -f docker-compose.prod.yml --env-file .env up -d --build`
# legge da qui. Chmod 600 sul VPS per non rischiare che gli altri utenti
# leggano la chiave Anthropic.
#
# SPDX-License-Identifier: AGPL-3.0-or-later

# --- organizzazione servita da questa istanza ---
# Un'istanza = un comune. Coerente con .env.example per lo sviluppo.
COMUNE_ISTAT=034027
NOME_COMUNE=Parma
ORG_NOME="Distretto di Parma"
ORG_TIPO=comune
# Ramo di calcolo dell'allerta:
#   - "bollettino" per le 27 città del bollettino ministeriale
#     (CITTA_BOLLETTINO deve essere valorizzata, es. BOLOGNA)
#   - "stima" per tutti gli altri comuni (Parma inclusa)
RAMO_ALLERTA=stima
CITTA_BOLLETTINO=
# Coordinate del centro del comune, usate da `allerta.py --stima`.
ORG_LAT=44.8015
ORG_LON=10.3280

# --- database ---
# Password NON quella di default. Genera con `openssl rand -hex 24`.
POSTGRES_USER=checaldo
POSTGRES_PASSWORD=<GENERA_CON_openssl_rand_hex_24>
POSTGRES_DB=checaldo
# DATABASE_URL è calcolata dal compose (POSTGRES_* sono i suoi ingredienti);
# le app dentro compose la ricevono già assemblata. Se serve DATABASE_URL
# da riga di comando (script host, mai in prod), va a mano.

# --- modello ---
# Chiave della console Anthropic. chmod 600 su .env.
ANTHROPIC_API_KEY=<sk-ant-...>
LLM_MODEL=claude-sonnet-4-6
# Tetto dedicato al consulente cittadino (fallback silenzioso oltre soglia).
LLM_DAILY_MISS_CAP_CONSULENTE=200
# Tetto dedicato all'agente città (a regime 1 miss/giorno, il cap difende
# dai giri di codegen con prompt cambiato ripetutamente).
LLM_DAILY_MISS_CAP_CITTA=10
# Tetto dedicato all'agente riassunto della giornata (dashboard coordinatore).
# Chiave a scaglioni di 5 contatti; giornata tipica ~40 contatti = 8 miss
# per org. Default 20 copre 2 org nella stessa istanza.
LLM_DAILY_MISS_CAP_RIASSUNTO=20

# --- deploy: dominio + HTTPS ---
# Il tuo dominio pubblico. Con DuckDNS gratuito, un sottodominio tipo
# `checaldo-parma.duckdns.org`. Serve un record A/AAAA che punti al VPS
# (per DuckDNS: aggiornabile via API con curl, vedi MOD07 checklist).
DOMINIO=<checaldo-parma.duckdns.org>
# Email per Let's Encrypt: avvisi di scadenza o problemi TLS finiscono qui.
LETSENCRYPT_EMAIL=<tua_email@dominio.tld>

# --- modalità ---
# La banda "dati sintetici — nessuna persona reale" compare SEMPRE
# tranne che con DEMO_MODE=false esplicito. Fail-safe voluto: dimenticare
# la variabile su questo VPS pubblico mostrerebbe altrimenti 500
# assistiti sintetici con nome, indirizzo ed età senza disclaimer,
# leggibili come reali. Su un deploy dimostrativo lasciare true (o
# omettere: stesso effetto). Metterla a false SOLO su un'installazione
# operativa reale con anagrafe vera dell'organizzazione ospitante.
DEMO_MODE=true
# Seed del generatore sintetico. Cambia solo se serve rigenerare la demo
# con dati diversi.
FAKER_SEED=42
DATA_BASE=

# --- URL di base dell'app ---
# Usata dalle route di login per costruire i redirect assoluti. Deve
# combaciare con DOMINIO sopra + schema (https). OBBLIGATORIA: in produzione
# l'avvio del server web fallisce esplicitamente se APP_URL non e' impostata.
# Il controllo evita il fallback silenzioso su http://localhost:3000 che
# manderebbe gli utenti sul localhost del VPS dopo il login.
APP_URL=https://<checaldo-parma.duckdns.org>

# --- sintesi vocale ---
# URL del servizio Piper interno (service `tts` nel compose). Se manca o il
# servizio non risponde, le route /api/tts/* tornano 503 e il pulsante di
# ascolto cade sulla sintesi Web Speech del browser dove disponibile
# (Chrome, Safari, Edge): la voce non sparisce, cambia timbro. Su Firefox
# con impostazioni default Web Speech non e' attivo: il pulsante non
# produce audio ma non mostra errore.
TTS_URL=http://tts:8080

# --- override per test / demo ---
# Data forzata "oggi" (ISO YYYY-MM-DD). Se vuota, si usa la data corrente in
# fuso Europe/Rome. In produzione va lasciata vuota: valorizzarla congela la
# giornata del sistema (poller, giro, punteggi) al valore fissato.
CHECALDO_OGGI=

# --- opzionale ---
# Geocoder Nominatim. Se manca, cade sul pubblico
# https://nominatim.openstreetmap.org (rate limit 1 req/s). In produzione
# reale puntare a un'istanza interna per evitare throttling.
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Endpoint Overpass per lo script one-shot estrai-vie.ts. Non serve al
# runtime del web (le vie sono versionate in packages/fixtures/data/).
OVERPASS_URL=https://overpass-api.de/api/interpreter
